# Copy this file to .env and fill in real values.
# .env is gitignored — never commit credentials.

# ── Postgres ──────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=auditai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=HCLLP@2026!

# ── MongoDB ───────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB=auditai

# ── Qdrant ────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# ── Redis ─────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Ollama (local dev — Gemma 3 12B) ─────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:12b

# ── File system paths ─────────────────────────────────────
INTAKE_FOLDER=/opt/auditai/intake
DATA_FOLDER=/opt/auditai/data
SOP_FOLDER=/opt/auditai/sop

# ── Airflow (only needed on Airflow node) ─────────────────
AIRFLOW_HOME=/opt/airflow
AIRFLOW_FERNET_KEY=change_me
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change_me

# ── MLflow ────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000

